# Admin Panel Environment Variables
# Copy this file to .env.test or .env.prod and adjust values

# Disable mock data
NEXT_PUBLIC_USE_MOCK=false

# Backend API URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://trihoback.mediann.dev/api/v1

# Host port for the admin container
ADMIN_PORT=3100

# SMTP — used by the backend for sending emails
# (registration confirmations, password resets, notifications)
# Provider: Timeweb Cloud (smtp.timeweb.ru)
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_USER=no-reply@trendrocket.tech
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=no-reply@trendrocket.tech
SMTP_SSL=true
